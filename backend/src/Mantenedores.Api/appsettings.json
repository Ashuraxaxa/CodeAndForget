{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hosting": {
    "PathBase": "",
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": [],
      "KnownNetworks": [],
      "TrustAllProxies": false
    }
  },
  "Storage": {
    "DataDirectory": "data"
  },
  "Metadata": {
    "Provider": "Sqlite",
    "ConnectionString": ""
  },
  "DataProtection": {
    "KeyStore": "FileSystem",
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "Crud": {
    "CommandTimeoutSeconds": 30,
    "ExportMaxRows": 100000,
    "ImportMaxRows": 10000,
    "ImportMaxMegabytes": 20
  },
  "Auth": {
    "Mode": "Local",
    "AdminRoles": [ "admin" ],
    "Issuer": "mantenedores",
    "TokenMinutes": 480,
    "JwtKey": "",
    "Users": [],
    "Jwt": {
      "Authority": "",
      "MetadataAddress": "",
      "SigningKey": "",
      "Audience": "",
      "Issuer": "",
      "RequireHttpsMetadata": true,
      "NameClaim": "",
      "RoleClaim": "",
      "RequiredScope": "",
      "ClockSkewSeconds": 60,
      "ClientId": "",
      "Scopes": "openid profile",
      "ProviderName": "el proveedor de identidad"
    }
  }
}
