<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mantenedores.Core\Mantenedores.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Lo trae SqlClient; la 9.0.18 tiene vulnerabilidades conocidas (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Scripts de migración por motor, embebidos con nombre estable: Migrations/<Motor>/<nnn>_<nombre>.sql -->
    <EmbeddedResource Include="Migrations\**\*.sql" LogicalName="Migrations/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
