{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "none",
  "roles": { "realm": [ { "name": "admin" }, { "name": "ventas" } ] },
  "clients": [
    {
      "clientId": "mantenedores-spa",
      "name": "Mantenedores (SPA)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [ "http://localhost:8080/*", "http://localhost:8093/*", "http://localhost:5173/*" ],
      "webOrigins": [ "+" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audiencia-mantenedores",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mantenedores-spa",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "email": "ana@demo.local",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Admin",
      "credentials": [ { "type": "password", "value": "ana", "temporary": false } ],
      "realmRoles": [ "admin", "ventas" ]
    },
    {
      "username": "luis",
      "enabled": true,
      "email": "luis@demo.local",
      "emailVerified": true,
      "firstName": "Luis",
      "lastName": "Ventas",
      "credentials": [ { "type": "password", "value": "luis", "temporary": false } ],
      "realmRoles": [ "ventas" ]
    }
  ]
}
